{
  "schemaVersion": 1,
  "id": "irq-operation-feedback",
  "preset": "Intel14900K",
  "language": "EN",
  "filter": "USB",
  "width": 1200,
  "height": 900,
  "steps": [
    {
      "id": "en-language",
      "action": "language",
      "value": "EN"
    },
    {
      "id": "en-model",
      "action": "irq-check-model",
      "value": "success",
      "durationMs": 900
    },
    {
      "id": "en-start",
      "action": "click",
      "target": "id:IRQ_MODE_CHECK"
    },
    {
      "id": "en-reading",
      "action": "assert",
      "target": "@main",
      "property": "irq-status",
      "value": "Status.IrqReading"
    },
    {
      "id": "en-last-result",
      "action": "assert",
      "target": "role:mode",
      "device": "DEV_461E",
      "value": "MSI"
    },
    {
      "id": "en-progress",
      "action": "capture"
    },
    {
      "id": "en-finish",
      "action": "wait",
      "target": "id:IRQ_MODE_CHECK",
      "property": "reading",
      "value": "false",
      "durationMs": 2500
    },
    {
      "id": "en-summary",
      "action": "assert",
      "target": "@main",
      "property": "irq-status",
      "value": "Status.IrqCompleted"
    },
    {
      "id": "en-all-pci",
      "action": "assert",
      "target": "@main",
      "property": "irq-all-pci-queried-once",
      "value": "true"
    },
    {
      "id": "en-result",
      "action": "assert",
      "target": "role:mode",
      "device": "DEV_461E",
      "value": "MSI"
    },
    {
      "id": "en-completed",
      "action": "capture"
    },
    {
      "id": "ru-language",
      "action": "language",
      "value": "RU"
    },
    {
      "id": "ru-model",
      "action": "irq-check-model",
      "value": "failure",
      "durationMs": 900
    },
    {
      "id": "ru-start",
      "action": "click",
      "target": "id:IRQ_MODE_CHECK"
    },
    {
      "id": "ru-reading",
      "action": "assert",
      "target": "@main",
      "property": "irq-status",
      "value": "Status.IrqReading"
    },
    {
      "id": "ru-last-result",
      "action": "assert",
      "target": "role:mode",
      "device": "DEV_461E",
      "value": "MSI"
    },
    {
      "id": "ru-progress",
      "action": "capture"
    },
    {
      "id": "ru-finish",
      "action": "wait",
      "target": "id:IRQ_MODE_CHECK",
      "property": "reading",
      "value": "false",
      "durationMs": 2500
    },
    {
      "id": "ru-summary",
      "action": "assert",
      "target": "@main",
      "property": "irq-status",
      "value": "Status.IrqCompleted"
    },
    {
      "id": "ru-all-pci",
      "action": "assert",
      "target": "@main",
      "property": "irq-all-pci-queried-once",
      "value": "true"
    },
    {
      "id": "ru-result",
      "action": "assert",
      "target": "role:mode",
      "device": "DEV_461E",
      "value": "ошибка чтения"
    },
    {
      "id": "ru-completed",
      "action": "capture"
    }
  ]
}
