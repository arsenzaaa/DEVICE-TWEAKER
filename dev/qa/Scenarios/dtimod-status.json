{
  "schemaVersion": 1, "id": "dtimod-status", "preset": "Intel14900K", "language": "EN", "filter": "USB", "width": 1200, "height": 900,
  "steps": [
    { "id": "initial", "action": "capture" },
    { "id": "incompatible", "action": "model-error", "value": "dtimod-incompatible" },
    { "id": "dialog", "action": "wait", "target": "@active", "value": "USB IMOD", "durationMs": 3000 },
    {"id": "restart-en-message", "action": "assert", "target": "text:DTIMOD is unavailable.\nRestart Windows, then press CHECK.", "property": "visible", "value": "true"},
    { "id": "restart-en", "action": "capture", "target": "@active" },
    { "id": "close-en", "action": "click", "target": "id:OK" },
    { "id": "idle-en", "action": "wait", "target": "@main", "property": "enabled", "value": "true", "durationMs": 2000 },
    { "id": "timeout-en", "action": "model-error", "value": "dtimod-pending" },
    { "id": "pending-en", "action": "wait", "target": "@active", "value": "USB IMOD", "durationMs": 3000 },
    {"id": "timeout-shot-en-message", "action": "assert", "target": "text:DTIMOD loading did not finish normally.\nRestart Windows, then press CHECK.", "property": "visible", "value": "true"},
    { "id": "timeout-shot-en", "action": "capture", "target": "@active" },
    { "id": "close-timeout-en", "action": "click", "target": "id:OK" },
    { "id": "idle-timeout", "action": "wait", "target": "@main", "property": "enabled", "value": "true", "durationMs": 2000 },
    { "id": "russian", "action": "language", "value": "RU" },
    { "id": "incompatible-ru", "action": "model-error", "value": "dtimod-incompatible" },
    { "id": "dialog-ru", "action": "wait", "target": "@active", "value": "USB IMOD", "durationMs": 3000 },
    {"id": "restart-ru-message", "action": "assert", "target": "text:DTIMOD недоступен.\nПерезагрузите Windows и нажмите ПРОВЕРИТЬ.", "property": "visible", "value": "true"},
    { "id": "restart-ru", "action": "capture", "target": "@active" },
    { "id": "close-ru", "action": "click", "target": "id:OK" },
    { "id": "idle-ru", "action": "wait", "target": "@main", "property": "enabled", "value": "true", "durationMs": 2000 },
    { "id": "timeout-ru", "action": "model-error", "value": "dtimod-pending" },
    { "id": "pending-ru", "action": "wait", "target": "@active", "value": "USB IMOD", "durationMs": 3000 },
    {"id": "timeout-shot-ru-message", "action": "assert", "target": "text:Загрузка DTIMOD не завершилась штатно.\nПерезагрузите Windows и нажмите ПРОВЕРИТЬ.", "property": "visible", "value": "true"},
    { "id": "timeout-shot-ru", "action": "capture", "target": "@active" },
    { "id": "close-timeout-ru", "action": "click", "target": "id:OK" },
    { "id": "done", "action": "wait", "target": "@main", "property": "enabled", "value": "true", "durationMs": 2000 }
  ]
}
