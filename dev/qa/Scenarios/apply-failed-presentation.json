{
  "schemaVersion": 1,
  "id": "apply-failed-presentation",
  "preset": "Intel14900K",
  "language": "EN",
  "filter": "USB",
  "width": 1200,
  "height": 900,
  "steps": [
    { "id": "show-editor", "action": "reveal", "target": "role:limit", "device": "DEV_461E" },
    { "id": "invalid-limit", "action": "text", "target": "role:limit", "device": "DEV_461E", "value": "12" },
    { "id": "before", "action": "capture" },
    { "id": "declare-validation-error", "action": "expect-apply-errors", "value": "1" },
    { "id": "apply-preview", "action": "click", "target": "id:APPLY" },
    { "id": "error-dialog", "action": "wait", "target": "@active", "value": "APPLY PREVIEW", "durationMs": 5000 },
    { "id": "validation-error-reported", "action": "assert", "target": "@main", "property": "last-apply-errors", "value": "1" },
    { "id": "not-applied", "action": "assert", "target": "text:Operation not applied", "property": "visible", "value": "true" },
    { "id": "preview-error", "action": "capture", "target": "@active" },
    { "id": "close-error", "action": "click", "target": "id:OK" },
    { "id": "idle", "action": "wait", "target": "@main", "property": "operation-active", "value": "false", "durationMs": 2000 },
    { "id": "accept-error-report", "action": "apply-completion-model", "value": "last" },
    { "id": "dirty-after-error", "action": "assert", "target": "role:title", "device": "DEV_461E", "property": "dirty", "value": "true" },
    { "id": "baseline-after-error", "action": "assert", "target": "role:limit", "device": "DEV_461E", "property": "initial-limit", "value": "Unlimited" },
    { "id": "accept-warning-report", "action": "apply-completion-model", "value": "warning" },
    { "id": "dirty-after-warning", "action": "assert", "target": "role:title", "device": "DEV_461E", "property": "dirty", "value": "true" },
    { "id": "baseline-after-warning", "action": "assert", "target": "role:limit", "device": "DEV_461E", "property": "initial-limit", "value": "Unlimited" },
    { "id": "show-retained-editor", "action": "reveal", "target": "role:limit", "device": "DEV_461E" },
    { "id": "pending-retained", "action": "capture" },
    { "id": "valid-value", "action": "text", "target": "role:limit", "device": "DEV_461E", "value": "2" },
    { "id": "accept-confirmed-report", "action": "apply-completion-model", "value": "success" },
    { "id": "clean-after-confirmed", "action": "assert", "target": "role:title", "device": "DEV_461E", "property": "dirty", "value": "false" },
    { "id": "new-baseline", "action": "assert", "target": "role:limit", "device": "DEV_461E", "property": "initial-limit", "value": "2" },
    { "id": "confirmed", "action": "capture" }
  ]
}
