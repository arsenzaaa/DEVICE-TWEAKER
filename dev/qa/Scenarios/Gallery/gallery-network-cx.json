{
  "schemaVersion": 1,
  "id": "gallery-network-cx",
  "preset": "DevicePalette",
  "language": "EN",
  "filter": "ALL",
  "width": 1320,
  "height": 1280,
  "steps": [
    {
      "id": "fixture-open",
      "action": "gallery"
    },
    {
      "id": "fixture-ready",
      "action": "wait",
      "target": "active:id:TEST_ADMIN_NAV_CPU",
      "property": "visible",
      "value": "true",
      "durationMs": 3000
    },
    {
      "id": "fixture-cpu",
      "action": "click",
      "target": "active:id:TEST_ADMIN_NAV_CPU"
    },
    {
      "id": "fixture-reveal",
      "action": "reveal",
      "target": "active:id:TEST_ADMIN_SYSTEM_PRESET"
    },
    {
      "id": "fixture-system",
      "action": "select",
      "target": "active:id:TEST_ADMIN_SYSTEM_PRESET",
      "value": "Full PC | X870E | Ryzen 9 9950X3D | RTX 5090 | Realtek 5G"
    },
    {
      "id": "fixture-close",
      "action": "click",
      "target": "active:id:TEST_ADMIN_CLOSE"
    },
    {
      "id": "en-language",
      "action": "language",
      "value": "EN"
    },
    {
      "id": "en-filter",
      "action": "text",
      "target": "@search",
      "value": "8126"
    },
    {
      "id": "en-home",
      "action": "scroll",
      "value": "Home"
    },
    {
      "id": "en-device",
      "action": "assert",
      "target": "role:title",
      "device": "DEV_8126",
      "property": "viewport",
      "value": "true"
    },
    {
      "id": "en-panel-reveal",
      "action": "reveal",
      "target": "role:settings",
      "device": "DEV_8126"
    },
    {
      "id": "en-panel-visible",
      "action": "assert",
      "target": "role:settings",
      "property": "viewport",
      "value": "true",
      "device": "DEV_8126"
    },
    {
      "id": "en-language-check",
      "action": "assert",
      "target": "@main",
      "property": "language",
      "value": "EN"
    },
    {
      "id": "en",
      "action": "capture-control",
      "target": "role:settings",
      "device": "DEV_8126"
    },
    {
      "id": "ru-language",
      "action": "language",
      "value": "RU"
    },
    {
      "id": "ru-filter",
      "action": "text",
      "target": "@search",
      "value": "8126"
    },
    {
      "id": "ru-home",
      "action": "scroll",
      "value": "Home"
    },
    {
      "id": "ru-device",
      "action": "assert",
      "target": "role:title",
      "device": "DEV_8126",
      "property": "viewport",
      "value": "true"
    },
    {
      "id": "ru-panel-reveal",
      "action": "reveal",
      "target": "role:settings",
      "device": "DEV_8126"
    },
    {
      "id": "ru-panel-visible",
      "action": "assert",
      "target": "role:settings",
      "property": "viewport",
      "value": "true",
      "device": "DEV_8126"
    },
    {
      "id": "ru-language-check",
      "action": "assert",
      "target": "@main",
      "property": "language",
      "value": "RU"
    },
    {
      "id": "ru",
      "action": "capture-control",
      "target": "role:settings",
      "device": "DEV_8126"
    }
  ]
}
