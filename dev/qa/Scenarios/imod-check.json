      "action": "wait",
      "durationMs": 3000,
      "target": "role:imod-check",
      "device": "DEV_461E",
      "value": "ПРОВЕРИТЬ"
    },
    {
      "id": "ru-still-disabled",
      "action": "assert",
      "property": "checked",
      "target": "role:imod-toggle",
      "device": "DEV_461E",
      "value": "false"
    },
    {
      "id": "ru-repeat",
      "action": "transition",
      "target": "role:imod-check",
      "device": "DEV_461E",
      "value": "ПРОВЕРИТЬ",
      "property": "text",
      "durationMs": 1800,
      "intervalMs": 120,
      "requireChange": false,
      "trigger": {
        "action": "click",
        "target": "role:imod-check",
        "device": "DEV_461E"
      }
