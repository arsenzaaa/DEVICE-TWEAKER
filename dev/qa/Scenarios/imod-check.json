    {
      "id": "show-hide",
      "action": "reveal",
      "target": "id:IMOD_DETAILS",
      "device": "DEV_461E"
    },
    {
      "id": "collapse",
      "action": "click",
      "target": "id:IMOD_DETAILS",
      "device": "DEV_461E"
    },
    {
      "id": "ru-check",
      "action": "click",
      "target": "role:imod-check",
      "device": "DEV_461E"
    },
    {
      "id": "ru-ack",
      "action": "wait",
      "durationMs": 1000,
      "target": "role:imod-check",
      "device": "DEV_461E",
      "value": "ПРОВЕРИТЬ"
