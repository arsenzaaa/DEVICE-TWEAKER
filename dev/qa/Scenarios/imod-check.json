      "target": "role:imod-toggle",
      "device": "DEV_461E"
    },
    {
      "id": "disable-auto",
      "action": "toggle",
      "target": "role:imod-toggle",
      "device": "DEV_461E",
      "value": "false"
    },
    {
      "id": "before",
      "action": "capture"
    },
    {
      "id": "check",
      "action": "click",
      "target": "role:imod-check",
      "device": "DEV_461E"
    },
    {
      "id": "acknowledged",
      "action": "wait",
      "durationMs": 1000,
      "target": "role:imod-check",
      "device": "DEV_461E",
      "value": "CHECK"
    },
    {
      "id": "ack",
      "action": "capture"
    },
    {
      "id": "still-disabled",
      "action": "assert",
      "property": "checked",
      "target": "role:imod-toggle",
      "device": "DEV_461E",
      "value": "false"
    },
    {
      "id": "table-open",
