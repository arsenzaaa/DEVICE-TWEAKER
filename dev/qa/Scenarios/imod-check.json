      "action": "wait",
      "durationMs": 3000,
      "target": "role:imod-check",
      "device": "DEV_461E",
      "value": "CHECK"
    },
    {
      "id": "after",
      "action": "capture"
    },
    {
      "id": "repeat",
      "action": "transition",
      "durationMs": 2000,
      "intervalMs": 120,
      "trigger": {
        "action": "click",
        "target": "role:imod-check",
