      "durationMs": 400,
      "intervalMs": 100,
      "trigger": {
        "action": "click",
        "target": "id:DELETE SELECTED"
      }
    },
    {
      "id": "restore-delete-exception-still-open",
      "action": "wait",
      "target": "@active",
      "value": "RESTORE",
      "durationMs": 3000
    },
    {
      "id": "restore-delete-exception-retry",
      "action": "assert",
      "target": "id:DELETE SELECTED",
      "property": "enabled",
      "value": "true"
    },
    {
      "id": "restore-delete-exception-state",
      "action": "capture",
      "target": "@active"
    },
    {
      "id": "restore-delete-exception-close",
      "action": "click",
      "target": "id:CANCEL"
    },
    {
      "id": "restore-delete-exception-done",
      "action": "wait",
      "target": "@main",
      "property": "enabled",
      "value": "true",
      "durationMs": 3000
    },
    {
      "id": "file-result",
      "action": "dialog",
      "value": "backup-restored"
    },
    {
      "id": "file-ready",
      "action": "wait",
      "target": "id:BACKUP_FILE",
      "property": "visible",
      "value": "true",
      "durationMs": 3000
    },
    {
      "id": "file-details",
      "action": "click",
      "target": "id:DETAILS"
    },
    {
      "id": "path-ready",
      "action": "wait",
      "target": "id:BACKUP_FULL_PATH",
      "property": "visible",
      "value": "true",
      "durationMs": 3000
    },
    {
      "id": "path",
      "action": "capture",
      "target": "@active"
    },
    {
      "id": "path-close",
      "action": "click",
      "target": "active:id:OK"
    },
    {
      "id": "result-close",
      "action": "click",
      "target": "active:id:OK"
    },
    {
      "id": "done",
      "action": "wait",
      "target": "@main",
      "property": "enabled",
