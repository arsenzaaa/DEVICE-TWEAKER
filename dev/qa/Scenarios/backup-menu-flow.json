{
  "schemaVersion": 1,
  "id": "backup-menu-flow",
  "preset": "Intel14900K",
  "language": "EN",
  "filter": "USB",
  "width": 1200,
  "height": 900,
  "steps": [
    {
      "id": "restore-open",
      "action": "dialog",
      "value": "restore"
    },
    {
      "id": "restore-ready",
      "action": "wait",
      "target": "id:DELETE SELECTED",
      "property": "enabled",
      "value": "true",
      "durationMs": 3000
    },
    {
      "id": "restore-delete",
      "action": "transition",
      "target": "@active",
      "durationMs": 400,
      "intervalMs": 100,
      "trigger": {
        "action": "click",
        "target": "id:DELETE SELECTED"
      }
    },
    {
      "id": "restore-still-open",
      "action": "wait",
      "target": "@active",
      "value": "RESTORE",
      "durationMs": 3000
    },
    {
      "id": "restore-disabled-DELETE-SELECTED",
      "action": "assert",
      "target": "id:DELETE SELECTED",
      "property": "enabled",
      "value": "false"
    },
    {
      "id": "restore-state",
      "action": "capture",
      "target": "@active"
    },
    {
      "id": "restore-remaining",
      "action": "click",
      "target": "id:RESTORE LAST"
    },
    {
      "id": "restore-done",
      "action": "wait",
      "target": "@main",
      "property": "enabled",
      "value": "true",
      "durationMs": 3000
    },
    {
      "id": "restore-one-open",
      "action": "dialog",
      "value": "restore-one"
    },
    {
      "id": "restore-one-ready",
