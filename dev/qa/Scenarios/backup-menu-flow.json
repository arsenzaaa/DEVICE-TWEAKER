      "property": "enabled",
      "value": "true"
    },
    {
      "id": "restore-delete-failure-state",
      "action": "capture",
      "target": "@active"
    },
    {
      "id": "restore-delete-failure-close",
      "action": "click",
      "target": "id:CANCEL"
    },
    {
      "id": "restore-delete-failure-done",
