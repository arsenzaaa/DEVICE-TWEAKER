      "durationMs": 3000
    },
    {
      "id": "restore-one-delete",
      "action": "transition",
      "target": "@active",
      "durationMs": 400,
      "intervalMs": 100,
      "trigger": {
        "action": "click",
        "target": "id:DELETE SELECTED"
      }
    },
    {
      "id": "restore-one-still-open",
      "action": "wait",
      "target": "@active",
      "value": "RESTORE",
      "durationMs": 3000
    },
    {
      "id": "restore-one-disabled-DELETE-SELECTED",
      "action": "assert",
      "target": "id:DELETE SELECTED",
      "property": "enabled",
      "value": "false"
    },
    {
      "id": "restore-one-disabled-RESTORE-LAST",
      "action": "assert",
      "target": "id:RESTORE LAST",
      "property": "enabled",
      "value": "false"
    },
    {
      "id": "restore-one-disabled-RESTORE-SELECTED",
      "action": "assert",
      "target": "id:RESTORE SELECTED",
      "property": "enabled",
      "value": "false"
    },
    {
      "id": "restore-one-state",
      "action": "capture",
      "target": "@active"
    },
    {
      "id": "restore-one-close",
      "action": "click",
      "target": "id:CANCEL"
    },
    {
      "id": "restore-one-done",
      "action": "wait",
      "target": "@main",
      "property": "enabled",
      "value": "true",
      "durationMs": 3000
    },
    {
      "id": "restore-delete-failure-open",
