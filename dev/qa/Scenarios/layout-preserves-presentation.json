{
  "schemaVersion": 1,
  "id": "layout-preserves-presentation",
  "preset": "Intel14900K",
  "language": "EN",
  "filter": "USB",
  "width": 1200,
  "height": 900,
  "steps": [
    { "id": "idle", "action": "wait", "target": "@main", "property": "refresh-idle", "value": "true", "durationMs": 5000 },
    { "id": "show-limit", "action": "reveal", "target": "role:limit", "device": "DEV_461E" },
    { "id": "edit-limit", "action": "text", "target": "role:limit", "device": "DEV_461E", "value": "2" },
    { "id": "edit-msi", "action": "select", "target": "role:msi", "device": "DEV_461E", "value": "Disabled" },
    { "id": "show-check", "action": "reveal", "target": "role:imod-check", "device": "DEV_461E" },
    { "id": "check-model", "action": "click", "target": "role:imod-check", "device": "DEV_461E" },
    { "id": "details-open", "action": "wait", "target": "id:IMOD_DETAILS", "device": "DEV_461E", "value": "HIDE", "durationMs": 2000 },
    { "id": "show-editor", "action": "reveal", "target": "role:limit", "device": "DEV_461E" },
    { "id": "focus-editor", "action": "focus", "target": "role:limit", "device": "DEV_461E" },
    { "id": "caret-end", "action": "key", "target": "role:limit", "device": "DEV_461E", "value": "End" },
    { "id": "caret-before", "action": "assert", "target": "role:limit", "device": "DEV_461E", "property": "caret", "value": "1" },
    { "id": "before", "action": "capture" },
    { "id": "map-before", "action": "assert", "target": "role:imod-map", "device": "DEV_461E", "property": "map-rows", "value": "8" },
    { "id": "rebind", "action": "layout-rebind", "value": "96" },
    { "id": "limit-preserved", "action": "assert", "target": "role:limit", "device": "DEV_461E", "value": "2" },
    { "id": "focus-preserved", "action": "assert", "target": "role:limit", "device": "DEV_461E", "property": "focused", "value": "true" },
    { "id": "caret-preserved", "action": "assert", "target": "role:limit", "device": "DEV_461E", "property": "caret", "value": "1" },
    { "id": "baseline-preserved", "action": "assert", "target": "role:limit", "device": "DEV_461E", "property": "initial-limit", "value": "Unlimited" },
    { "id": "msi-preserved", "action": "assert", "target": "role:msi", "device": "DEV_461E", "property": "value", "value": "Disabled" },
    { "id": "pending-preserved", "action": "assert", "target": "role:title", "device": "DEV_461E", "property": "dirty", "value": "true" },
    { "id": "details-preserved", "action": "assert", "target": "id:IMOD_DETAILS", "device": "DEV_461E", "value": "HIDE" },
    { "id": "map-rows-preserved", "action": "assert", "target": "role:imod-map", "device": "DEV_461E", "property": "map-rows", "value": "8" },
    { "id": "viewport-preserved", "action": "assert", "target": "role:limit", "device": "DEV_461E", "property": "viewport", "value": "true" },
    { "id": "after", "action": "capture" },
    { "id": "show-restored-map", "action": "reveal", "target": "role:imod-current", "device": "DEV_461E" },
    { "id": "map-restored", "action": "capture" },
    { "id": "russian", "action": "language", "value": "RU" },
    { "id": "scale125", "action": "layout-rebind", "value": "120" },
    { "id": "show-scaled-editor", "action": "reveal", "target": "role:limit", "device": "DEV_461E" },
    { "id": "scaled-limit-preserved", "action": "assert", "target": "role:limit", "device": "DEV_461E", "value": "2" },
    { "id": "scaled-dirty-preserved", "action": "assert", "target": "role:title", "device": "DEV_461E", "property": "dirty", "value": "true" },
    { "id": "scaled", "action": "capture" },
    { "id": "return100", "action": "layout-rebind", "value": "96" },
    { "id": "final-baseline", "action": "assert", "target": "role:limit", "device": "DEV_461E", "property": "initial-limit", "value": "Unlimited" },
    { "id": "returned", "action": "capture" }
  ]
}
