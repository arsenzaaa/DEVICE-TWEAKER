    },
    {
      "id": "storage-ru-visible",
      "action": "assert",
      "target": "role:title",
      "device": "DEV_A80C",
      "property": "viewport",
      "value": "true"
    },
    {
      "id": "storage-ru",
      "action": "capture"
    }
