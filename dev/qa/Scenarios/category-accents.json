      "device": "DEV_A80C",
      "property": "viewport",
      "value": "true"
    },
    {
      "id": "storage-en",
      "action": "capture"
    },
    {
      "id": "ru-language",
      "action": "language",
      "value": "RU"
    },
    {
      "id": "network-ru-navigate",
      "action": "click",
