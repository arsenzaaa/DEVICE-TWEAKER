      "target": "id:FILTER_NETWORK"
    },
    {
      "id": "network-en-visible",
      "action": "assert",
      "target": "role:title",
      "device": "DEV_125C",
      "property": "viewport",
      "value": "true"
    },
    {
      "id": "network-en",
      "action": "capture"
    },
    {
      "id": "storage-en-navigate",
      "action": "click",
      "target": "id:FILTER_STORAGE"
    },
    {
      "id": "storage-en-visible",
      "action": "assert",
