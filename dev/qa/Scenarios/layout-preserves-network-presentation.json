{
  "schemaVersion": 1,
  "id": "layout-preserves-network-presentation",
  "preset": "NicItr",
  "language": "EN",
  "filter": "NETWORK",
  "width": 1200,
  "height": 900,
  "steps": [
    {
      "id": "show-queues",
      "action": "reveal",
      "target": "role:rss-queues",
      "device": "DEV_125C"
    },
    {
      "id": "initial-queues",
      "action": "assert",
      "target": "role:rss-queues",
      "device": "DEV_125C",
      "property": "value",
      "value": "4"
    },
    {
      "id": "edit-queues",
      "action": "select",
      "target": "role:rss-queues",
      "device": "DEV_125C",
      "value": "2"
    },
    {
      "id": "base-before",
      "action": "assert",
      "target": "role:rss-queues",
      "device": "DEV_125C",
      "property": "rss-base",
      "value": "8"
    },
    {
      "id": "show-nic",
      "action": "reveal",
      "target": "role:nic-itr",
      "device": "DEV_125C"
    },
    {
      "id": "edit-nic",
      "action": "text",
      "target": "role:nic-itr",
      "device": "DEV_125C",
      "value": "0x28"
    },
    {
      "id": "before-refresh",
      "action": "capture"
    },
    {
      "id": "rebind",
      "action": "layout-rebind",
      "value": "96"
    },
    {
      "id": "nic-preserved",
      "action": "assert",
      "target": "role:nic-itr",
      "device": "DEV_125C",
      "value": "0x28"
    },
    {
      "id": "queues-preserved",
      "action": "assert",
      "target": "role:rss-queues",
      "device": "DEV_125C",
      "property": "value",
      "value": "2"
    },
    {
      "id": "base-preserved",
      "action": "assert",
      "target": "role:rss-queues",
      "device": "DEV_125C",
      "property": "rss-base",
      "value": "8"
    },
    {
      "id": "affinity-preserved",
      "action": "assert",
      "target": "role:affinity",
      "device": "DEV_125C",
      "value": "Affinity (RSS mask): 0x500"
    },
    {
      "id": "scroll-preserved",
      "action": "assert",
      "target": "role:nic-itr",
      "device": "DEV_125C",
      "property": "viewport",
      "value": "true"
    },
    {
      "id": "after-refresh",
      "action": "capture"
    },
    {
      "id": "scale150",
      "action": "layout-rebind",
      "value": "144"
    },
    {
      "id": "scaled-nic",
      "action": "assert",
      "target": "role:nic-itr",
      "device": "DEV_125C",
      "value": "0x28"
    },
    {
      "id": "scaled-queues",
      "action": "assert",
      "target": "role:rss-queues",
      "device": "DEV_125C",
      "property": "value",
      "value": "2"
    },
    {
      "id": "scaled-base",
      "action": "assert",
      "target": "role:rss-queues",
      "device": "DEV_125C",
      "property": "rss-base",
      "value": "8"
    },
    {
      "id": "show-scaled",
      "action": "reveal",
      "target": "role:nic-itr",
      "device": "DEV_125C"
    },
    {
      "id": "scaled",
      "action": "capture"
    },
    {
      "id": "return100",
      "action": "layout-rebind",
      "value": "96"
    },
    {
      "id": "russian",
      "action": "language",
      "value": "RU"
    },
    {
      "id": "show-returned",
      "action": "reveal",
      "target": "role:nic-itr",
      "device": "DEV_125C"
    },
    {
      "id": "returned-nic",
      "action": "assert",
      "target": "role:nic-itr",
      "device": "DEV_125C",
      "value": "0x28"
    },
    {
      "id": "returned-dirty",
      "action": "assert",
      "target": "role:title",
      "device": "DEV_125C",
      "property": "dirty",
      "value": "true"
    },
    {
      "id": "returned",
      "action": "capture"
    }
  ]
}
