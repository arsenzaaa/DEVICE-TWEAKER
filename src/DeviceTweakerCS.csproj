<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <ApplicationManifest>assets\app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\DEVICE TWEAKER.ico</ApplicationIcon>
    <!-- QA runs keep source copies under tmp; they must not enter the compile graph. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tmp\**</DefaultItemExcludes>

    <AssemblyName>DEVICE TWEAKER</AssemblyName>
    <RootNamespace>DeviceTweakerCS</RootNamespace>
    <AssemblyTitle>DEVICE TWEAKER</AssemblyTitle>

    <Version>0.0.4</Version>
    <AssemblyVersion>0.0.4.0</AssemblyVersion>
    <FileVersion>0.0.4.0</FileVersion>
    <InformationalVersion>0.0.4</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Company>arsenza</Company>
    <Authors>@arsenza</Authors>
    <Product>DEVICE TWEAKER</Product>
    <Copyright>Copyright (c) arsenza</Copyright>

    <BuildImodDriver Condition="'$(BuildImodDriver)' == '' and !Exists('IMOD\DTIMOD.sys')">true</BuildImodDriver>
    <BuildImodDriver Condition="'$(BuildImodDriver)' == ''">false</BuildImodDriver>
    <DeveloperQa Condition="'$(DeveloperQa)' == ''">false</DeveloperQa>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SelfContained)' == 'true' and '$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeveloperQa)' == 'true'">
    <DefineConstants>$(DefineConstants);DEVELOPER_QA</DefineConstants>
    <AssemblyName>DEVICE TWEAKER QA</AssemblyName>
    <OutputPath>bin\DeveloperQa\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\DeveloperQa\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(DeveloperQa)' == 'true'">
    <Compile Include="..\dev\qa\Panel\*.cs" Link="DeveloperQa\%(Filename)%(Extension)" />
    <Compile Include="..\dev\qa\Workbench\*.cs" Link="DeveloperQa\Workbench\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="IMOD\KDU\**\*.cs" />
    <!-- The logon script compiles this C# itself; the app only ships it as text. -->
    <Compile Remove="Startup\**\*.cs" />
    <EmbeddedResource Include="Startup\ApplyIMOD.ps1">
      <LogicalName>DeviceTweakerCS.Startup.ApplyIMOD.ps1</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Startup\DeviceTweakerImodRuntime.cs">
      <LogicalName>DeviceTweakerCS.Startup.DeviceTweakerImodRuntime.cs</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <InternalsVisibleTo Include="DeviceTweaker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\DriverRename.cs">
      <LogicalName>DeviceTweakerCS.DriverRename.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Core\DriverRuntime.cs">
      <LogicalName>DeviceTweakerCS.DriverRuntime.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\DEVICE TWEAKER.ico">
      <LogicalName>DeviceTweakerCS.AppIcon</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="IMOD\\DTIMOD.sys">
      <LogicalName>DeviceTweakerCS.IMOD.DTIMOD.sys</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="IMOD\\DTIMOD.sys.sha256">
      <LogicalName>DeviceTweakerCS.IMOD.DTIMOD.sys.sha256</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="IMOD\\Loader\\kdu.exe">
      <LogicalName>DeviceTweakerCS.IMOD.Loader.kdu.exe</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="IMOD\\Loader\\drv64.dll">
      <LogicalName>DeviceTweakerCS.IMOD.Loader.drv64.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="BuildImodDriverArtifact"
          BeforeTargets="PrepareForBuild"
          Condition="'$(BuildImodDriver)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\publish-variants.ps1&quot; -BuildDriverOnly -Configuration &quot;$(Configuration)&quot;" />
  </Target>

</Project>
